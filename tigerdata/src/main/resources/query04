SELECT 
    usage_date,
    vin,
    duration_in(state_summary, 'Working') +  
    duration_in(state_summary, 'Idle') AS total_operating_time  
FROM daily_machine_usage  
WHERE vin = ? 
  AND usage_date >= INTERVAL_PLACEHOLDER 
ORDER BY usage_date DESC 

