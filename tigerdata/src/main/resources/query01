SELECT
  vin,
  site_id,
  duration_in(state_agg(recorded_at, engine_state), 'Working') AS working_hours,
  duration_in(state_agg(recorded_at, engine_state), 'Idle') AS idle_hours,
  duration_in(state_agg(recorded_at, engine_state), 'Working') +
  duration_in(state_agg(recorded_at, engine_state), 'Idle') AS total_operating_time 
FROM telematics_data 
WHERE site_id = ?  
AND recorded_at >= INTERVAL_PLACEHOLDER 
GROUP BY 1, 2
