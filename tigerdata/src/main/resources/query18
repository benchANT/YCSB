WITH threshold_breaches AS (
 SELECT
   vin,
   -- Count how many times thresholds were broken in the last 24 hours
   SUM(CASE
         WHEN recorded_at >= NOW() - INTERVAL '24 hours' THEN 1
         ELSE 0
       END) AS breaches_last_24h,
      
   -- Count how many times thresholds were broken in the last 7 days
   COUNT(recorded_at) AS breaches_last_7d
  
 FROM telematics_data
 -- Limit the entire scan to the last 7 days
 WHERE recorded_at >= NOW() - INTERVAL '7 days'
   -- The Breach Conditions
   AND (
     coolant_temperature > 70 OR
     hydraulic_oil_temperature > 70 OR
     engine_rpm > 2000
   )
 GROUP BY vin
)
SELECT
 b.vin,
 m.make,
 m.model,
 b.breaches_last_24h,
 b.breaches_last_7d
FROM threshold_breaches b
JOIN machines m ON b.vin = m.vin
ORDER BY b.breaches_last_7d DESC, b.breaches_last_24h DESC;