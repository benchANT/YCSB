WITH raw_data AS (
  SELECT 
    vin,
    CASE 
      WHEN time_bucket_15m >= INTERVAL_PLACEHOLDER_1 THEN 'Current' 
      ELSE 'Baseline' 
    END AS period,
    CASE 
      WHEN starting_fuel > ending_fuel THEN starting_fuel - ending_fuel 
      ELSE 0 
    END AS fuel_dropped,
    working_seconds AS working_sec,
    idle_seconds AS idle_sec,
    max_coolant_temperature AS max_coolant, 
    max_hydraulic_oil_temperature AS max_hydro 
  FROM fleet_metrics_15m 
  WHERE time_bucket_15m >= INTERVAL_PLACEHOLDER_2 
), 
allocated_metrics AS ( 
  SELECT 
    vin,
    period,
    working_sec,
    idle_sec,
    max_coolant,
    max_hydro,
    COALESCE(fuel_dropped * (working_sec / NULLIF(working_sec + idle_sec, 0)), 0) AS working_fuel
  FROM raw_data 
), 
period_summaries AS ( 
  SELECT 
    vin, 
    period, 
    SUM(working_sec) / 3600.0 AS work_hrs, 
    SUM(idle_sec) / 3600.0 AS idle_hrs, 
    SUM(working_fuel) AS total_work_fuel, 
    AVG(max_coolant) AS avg_peak_coolant, 
    AVG(max_hydro) AS avg_peak_hydro 
  FROM allocated_metrics 
  GROUP BY vin, period 
), 
pivoted_baselines AS (
  SELECT 
    vin,
    MAX(CASE WHEN period = 'Baseline' THEN work_hrs + idle_hrs ELSE 0 END) AS b_active_hrs,
    MAX(CASE WHEN period = 'Current' THEN work_hrs + idle_hrs ELSE 0 END) AS c_active_hrs,
    MAX(CASE WHEN period = 'Baseline' THEN idle_hrs / NULLIF(work_hrs + idle_hrs, 0) * 100 ELSE 0 END) AS b_idle_pct,
    MAX(CASE WHEN period = 'Current' THEN idle_hrs / NULLIF(work_hrs + idle_hrs, 0) * 100 ELSE 0 END) AS c_idle_pct,
    MAX(CASE WHEN period = 'Baseline' THEN total_work_fuel / NULLIF(work_hrs, 0) ELSE 0 END) AS b_burn_rate,
    MAX(CASE WHEN period = 'Current' THEN total_work_fuel / NULLIF(work_hrs, 0) ELSE 0 END) AS c_burn_rate,
    MAX(CASE WHEN period = 'Baseline' THEN avg_peak_coolant ELSE 0 END) AS b_coolant,
    MAX(CASE WHEN period = 'Current' THEN avg_peak_coolant ELSE 0 END) AS c_coolant,
    MAX(CASE WHEN period = 'Baseline' THEN avg_peak_hydro ELSE 0 END) AS b_hydro,
    MAX(CASE WHEN period = 'Current' THEN avg_peak_hydro ELSE 0 END) AS c_hydro
  FROM period_summaries
  GROUP BY vin
)  
SELECT 
  p.vin,
  m.make,
  m.model,
  ROUND((p.c_idle_pct - p.b_idle_pct)::numeric, 2) AS idle_pct_increase,
  ROUND((p.c_burn_rate - p.b_burn_rate)::numeric, 2) AS burn_rate_increase,
  ROUND((p.c_coolant - p.b_coolant)::numeric, 2) AS coolant_temp_increase,
  ROUND((p.c_hydro - p.b_hydro)::numeric, 2) AS hydro_temp_increase,
  CONCAT_WS(' | ', 
    CASE WHEN (p.c_idle_pct - p.b_idle_pct) >= 5.0 THEN 'High Idle' END, 
    CASE WHEN (p.c_burn_rate - p.b_burn_rate) >= 2.0 THEN 'Inefficient Fuel' END, 
    CASE WHEN (p.c_coolant - p.b_coolant) >= 5.0 THEN 'Hot Coolant' END, 
    CASE WHEN (p.c_hydro - p.b_hydro) >= 5.0 THEN 'Hot Hydraulics' END 
  ) AS degradation_flags 
FROM pivoted_baselines p 
JOIN machines m ON p.vin = m.vin 
WHERE p.b_active_hrs > 5 AND p.c_active_hrs > 5 
  AND (
    (p.c_idle_pct - p.b_idle_pct) >= 5.0 OR
    (p.c_burn_rate - p.b_burn_rate) >= 2.0 OR
    (p.c_coolant - p.b_coolant) >= 5.0 OR
    (p.c_hydro - p.b_hydro) >= 5.0
  )
ORDER BY 
  coolant_temp_increase DESC, 
  burn_rate_increase DESC


