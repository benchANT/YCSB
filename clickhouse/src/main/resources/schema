-- Track the operators assigned to the machines
CREATE TABLE rtiot.operators (
 operator_id BigInt,
 first_name VARCHAR(100) NOT NULL,
 last_name VARCHAR(100) NOT NULL,
  PRIMARY KEY(operator_id)
);

CREATE TABLE sites (
 site_id INT PRIMARY KEY,
 address TEXT NOT NULL,
 is_active BOOLEAN,
 construction_begin BIGINT NOT NULL,
 construction_end BIGINT NOT NULL
);

CREATE TABLE machines (
 vin TEXT PRIMARY KEY,
 make LowCardinality(TEXT), 
 model LowCardinality(TEXT),
 weight_class_tons FLOAT,
 purchase_date BIGINT,
 current_status LowCardinality(TEXT) NOT NULL
);

CREATE TABLE telematics_data (
  recorded_at DateTime64(6) NOT NULL,
  vin TEXT NOT NULL, -- references machines
  operator_id BigInt NOT NULL, -- references operators
  site_id INT NOT NULL, -- references sites,
  latitude Float32,
  longitude Float32,
  engine_state LowCardinality(TEXT), -- Off, Idle, Working
  fuel_level_percent Float32,
  engine_rpm UINT16,
  coolant_temperature Float32,
  hydraulic_oil_temperature Float32
) 
PARTITION BY toYYYYMMDD(recorded_at)
ORDER BY vin;

-- MATERIALIZED VIEWS 

-- Terminology is a bit different. 
-- In TigerData, MATERIALIZED VIEW is actually something like a table that one can query against
-- In Clickhouse, a MATERIALIZED VIEW is only a trigger that "copies" data from source table(s) to
-- a destination table and does some data processing. So, we need a further table to keep the data

----- 15 minute operator activity

CREATE TABLE operator_activity_15m (
  time_bucket_15m DateTime(6),
  operator_id BigInt NOT NULL,
  working_ping_count UInt32,
  idle_ping_count UInt32,
  off_ping_count UInt32,
  total_ping_count UInt32
)
PRIMARY KEY operator_id
ORDER BY (operator_id, time_bucket_15m)

CREATE MATERIALIZED VIEW operator_activity_15m_mv 
REFRESH EVERY 1 YEAR OFFSET 11 MONTH
TO operator_activity_15m
AS SELECT
 toStartOfInterval(recorded_at, INTERVAL 15 MINUTE) AS time_bucket_15m, 
 operator_id,
 COUNT(*) FILTER (WHERE engine_state = 'Working') AS working_ping_count,
 COUNT(*) FILTER (WHERE engine_state = 'Idle') AS idle_ping_count,
 COUNT(*) FILTER (WHERE engine_state = 'Off') AS off_ping_count,
 COUNT(*) AS total_ping_count
FROM telematics_data
WHERE operator_id IS NOT NULL
GROUP BY 1, 2;

