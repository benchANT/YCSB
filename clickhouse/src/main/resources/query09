WITH bucket_calculations AS ( 
 SELECT 
   vin, 
   CASE 
     WHEN starting_fuel > ending_fuel THEN starting_fuel - ending_fuel 
     ELSE 0 
   END AS fuel_dropped_pct, 
   working_seconds, 
   idle_seconds 
 FROM fleet_metrics_15m 
 WHERE time_bucket_15m >= INTERVAL_PLACEHOLDER 
), 
allocated_fuel AS ( 
  SELECT 
   vin, 
   working_seconds, 
   idle_seconds, 
   COALESCE(fuel_dropped_pct * (working_seconds / NULLIF(working_seconds + idle_seconds, 0)), 0) AS working_fuel_pct, 
   COALESCE(fuel_dropped_pct * (idle_seconds / NULLIF(working_seconds + idle_seconds, 0)), 0) AS idle_fuel_pct 
 FROM bucket_calculations 
), 
state_totals AS ( 
  SELECT 
   vin, 
   SUM(working_seconds) / 900.0 AS total_working_hours, 
   SUM(idle_seconds) / 900.0 AS total_idle_hours, 
   SUM(working_fuel_pct) AS total_working_fuel_pct, 
   SUM(idle_fuel_pct) AS total_idle_fuel_pct 
 FROM allocated_fuel 
 GROUP BY vin 
) 
SELECT 
 vin, 
 ROUND(total_working_hours::numeric, 2) AS working_hours, 
 ROUND(total_idle_hours::numeric, 2) AS idle_hours, 
 ROUND((total_working_fuel_pct / NULLIF(total_working_hours, 0))::numeric, 2) AS working_fuel_pct_per_hour, 
 ROUND((total_idle_fuel_pct / NULLIF(total_idle_hours, 0))::numeric, 2) AS idle_fuel_pct_per_hour 
FROM state_totals 
WHERE total_working_hours > 0 OR total_idle_hours > 0 
ORDER BY idle_fuel_pct_per_hour DESC

